# MCP prepaid card amount (5–30 SGD). Sandbox minimum is 5.
CARD_MCP_AMOUNT_SGD=5
# Merchant / x402 payTo (your other account)
MERCHANT_WALLET_ADDRESS=
CROSSMINT_API_KEY=
CROSSMINT_WALLET_ADDRESS=

X402_FACILITATOR_URL=https://facilitator.ultravioletadao.xyz
X402_NETWORK=eip155:43114

# RainbowKit removed — wagmi injected (MetaMask/Core). Optional WC id unused.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Equippable skill / gateway (optional auth for /api/gateway/*)
